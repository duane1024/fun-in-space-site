---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/">Fun in Space</a>
        <nav>
          <ul>
            {site.nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Duane Moore</p>
        <div class="footer-links">
          <a href={site.social.x}>X</a>
          <a href={site.social.substack}>Substack</a>
          <a href={site.social.linkedin}>LinkedIn</a>
          <a href={site.social.sancho}>Sancho AI</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #0b1020;
    --panel: #121a31;
    --soft: #1a2547;
    --text: #ebefff;
    --muted: #a9b4d0;
    --accent: #8db8ff;
    --accent-strong: #bfd6ff;
    --border: rgba(173, 190, 255, 0.18);
    --max: 1120px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: linear-gradient(180deg, #09101f 0%, #0b1020 100%);
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  a {
    color: var(--accent-strong);
    text-decoration: none;
  }

  a:hover {
    color: white;
  }

  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header,
  .site-footer,
  main {
    width: min(calc(100% - 2rem), var(--max));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    gap: 1rem;
  }

  .wordmark {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: white;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  main {
    flex: 1;
    padding: 2rem 0 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    main {
      padding-top: 1rem;
    }
  }
</style>
