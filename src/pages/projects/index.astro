---
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import CardGrid from '../../components/CardGrid.astro';
import Section from '../../components/Section.astro';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const ventures = (await getCollection('ventures')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Projects — Duane Moore" description="Selected projects, ventures, and technical work by Duane Moore.">
  <Section title="Projects" intro="Current products, technical experiments, and work worth showing off in public.">
    <CardGrid>
      {projects.map((entry) => (
        <Card title={entry.data.title} subtitle={entry.data.status} body={entry.data.summary} links={entry.data.links} />
      ))}
    </CardGrid>
  </Section>

  <Section title="Ventures and companies" intro="Some things start as products, some as companies, and some as delightful trouble.">
    <CardGrid>
      {ventures.map((entry) => (
        <Card title={entry.data.title} subtitle={`${entry.data.role} · ${entry.data.timeframe}`} body={entry.data.summary} links={entry.data.links} />
      ))}
    </CardGrid>
  </Section>
</Layout>
