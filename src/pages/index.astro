---
import { getCollection } from 'astro:content';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const ventures = (await getCollection('ventures'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const career = (await getCollection('career'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
const tweets = (await getCollection('tweets'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Duane Moore — Fun in Space" description={site.description}>
  <section class="hero">
    <p class="eyebrow">{site.hero.eyebrow}</p>
    <h1>{site.hero.title}</h1>
    <p class="blurb">{site.hero.blurb}</p>
    <p class="detail">{site.hero.detail}</p>
    <div class="cta-row">
      <a class="button primary" href="/projects/">View projects</a>
      <a class="button" href="/writing/">Read writing</a>
      <a class="button" href={site.social.substack}>Substack</a>
      <a class="button" href={site.social.github}>GitHub</a>
    </div>
  </section>

  <Section title="Featured projects" intro="Products and technical work that best capture what Duane is building now.">
    <CardGrid>
      {projects.map((entry) => (
        <Card title={entry.data.title} subtitle={entry.data.status} body={entry.data.summary} links={entry.data.links} />
      ))}
    </CardGrid>
  </Section>

  <Section title="Companies and ventures" intro="A mix of startups, consulting, and product bets — not just jobs, but things built from the inside.">
    <CardGrid>
      {ventures.map((entry) => (
        <Card title={entry.data.title} subtitle={`${entry.data.role} · ${entry.data.timeframe}`} body={entry.data.summary} links={entry.data.links} />
      ))}
    </CardGrid>
  </Section>

  <Section title="Career highlights" intro="A few stops where the scale, complexity, or impact was too meaningful to bury in a resume PDF.">
    <CardGrid>
      {career.map((entry) => (
        <article class="career-card">
          <p class="subtitle">{entry.data.role}</p>
          <h3>{entry.data.company}</h3>
          <p class="summary">{entry.data.summary}</p>
          <ul>
            {entry.data.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </CardGrid>
  </Section>

  <Section title="Writing" intro="Older technical writing lives here in the Fun in Space archive. Newer essays and commentary live on Substack.">
    <div class="writing-grid">
      <div class="panel">
        <h3>Fun in Space archive</h3>
        <p>The original WordPress posts are now preserved here as a browsable archive instead of being left to rot in a legacy platform.</p>
        <ul>
          {writing.map((entry) => (
            <li>
              <a href={`/writing/${entry.id}/`}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="panel">
        <h3>Newer writing on Substack</h3>
        <p>For more recent essays, analysis, and updates, Substack is the best place to follow along.</p>
        <a class="text-link" href={site.social.substack}>Visit duane1024.substack.com</a>
      </div>
    </div>
  </Section>

  <Section title="Selected posts from X" intro="A few recent posts that reflect Duane's current public voice: builder energy, technical judgment, and occasional side-eye.">
    <div class="tweet-list">
      {tweets.map((entry) => (
        <article class="tweet">
          <p>{entry.body}</p>
          <a href={entry.data.url}>View on X</a>
        </article>
      ))}
    </div>
  </Section>
</Layout>

<style>
  .hero {
    padding: 3rem 0 1.5rem;
    max-width: 780px;
  }

  .eyebrow,
  .subtitle {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 0.95;
  }

  .blurb {
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .detail {
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.75;
    max-width: 70ch;
  }

  .cta-row {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .button {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.75rem 1rem;
    color: var(--text);
    background: rgba(18, 26, 49, 0.9);
  }

  .button.primary {
    background: var(--accent);
    color: #08101d;
    font-weight: 700;
  }

  .career-card,
  .panel,
  .tweet {
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(18, 26, 49, 0.95), rgba(11, 16, 32, 0.95));
    border-radius: 18px;
    padding: 1.2rem;
  }

  .career-card h3,
  .panel h3 {
    margin: 0.2rem 0 0.5rem;
  }

  .summary,
  .panel p,
  .tweet p {
    color: var(--muted);
    line-height: 1.65;
  }

  .career-card ul,
  .panel ul {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .writing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .tweet-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
</style>
