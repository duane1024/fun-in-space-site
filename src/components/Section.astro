---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="section">
  <div class="heading">
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .section {
    margin-top: 4rem;
  }

  .heading {
    margin-bottom: 1.25rem;
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }

  .heading p {
    margin: 0;
    color: var(--muted);
    max-width: 70ch;
    line-height: 1.6;
  }
</style>
